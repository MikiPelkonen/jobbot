{
  "name": "jobbot",
  "version": "1.1.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "scrape": "bun src/index.ts",
    "scrape:details": "bun src/index.ts --details",
    "apply": "bun src/apply.ts",
    "apply:4": "bun src/apply.ts --top=4 --min-score=5",
    "apply:top10": "bun src/apply.ts --top=10 --min-score=5",
    "apply:20": "bun src/apply.ts --top=20 --min-score=3",
    "cv": "bun src/cv/index.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "release": "npm version"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "smol-toml": "^1.6.1"
  }
}
